# Copy to .env.local (gitignored) and fill in. Restart `npm run dev` after changing it.
# No Hugging Face token goes here: every visitor enters their own token in the app
# (Shape Studio: Model & strength; Future Lab: the token chip in the top bar).

# Future Lab model settings (all optional).
# HF_PROVIDER=auto                                  # auto, groq, cerebras, novita, together, fal-ai, hf-inference…
# HF_LLM_MODEL=openai/gpt-oss-120b                  # text planner
# HF_VLM_MODEL=Qwen/Qwen3.8-27B                     # vision planner + AI part names
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell   # textures, decals, 360° wraps
# HF_TIMEOUT=120                                    # seconds
# HF_3D_SPACE=microsoft/TRELLIS.2                   # image-to-3D Space for "Text to 3D" (uses ZeroGPU quota)
